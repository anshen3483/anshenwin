rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isAdmin();
      // Profile writes must be restricted to approved fields in a production schema.
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }
    match /tournaments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isAdmin();
      allow write: if false; // Only trusted server code may modify balances.
    }
    match /walletTransactions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /reports/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /processedPaymentEvents/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
